# Replit configuration — StudyMind API (Express + TypeScript).
#
# The repo is an npm-workspaces monorepo (server/ + web/). Only the API is run
# here; the frontend is deployed separately to Vercel.
#
# `run` builds TypeScript then starts the compiled server. index.ts binds
# 0.0.0.0:$PORT, which is what Replit requires for the Run button to work.

run = "npm install && npm run build -w @studymind/server && npm run start -w @studymind/server"
entrypoint = "server/dist/index.js"
modules = ["nodejs-20"]
hidden = [".config", "package-lock.json", "node_modules", ".next", "evaluation/results"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "npm install && npm run build -w @studymind/server && npm run start -w @studymind/server"]
build = ["sh", "-c", "npm install && npm run build -w @studymind/server"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3001
externalPort = 80

[[ports]]
localPort = 3000
externalPort = 3000
