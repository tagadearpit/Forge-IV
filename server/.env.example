# ---------- Core ----------
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:3000

# ---------- Database ----------
# MongoDB Atlas connection string (mongodb+srv://...). If unset, the server
# falls back to an ephemeral in-process MongoDB so the app is fully runnable
# without external setup. Set it to persist data.
MONGODB_URI=
MONGODB_DB=studymind

# ---------- Auth ----------
# MUST be replaced in production. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_COST=12

# ---------- AI provider ----------
# Leave GEMINI_API_KEY empty to run in LOCAL mode: a deterministic, fully
# offline provider that does real extractive RAG + keyword retrieval over your
# uploaded material. No fabricated answers. Set the key to use real Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004
# force = gemini | local  (default: gemini if GEMINI_API_KEY is set, else local)
AI_PROVIDER=

# ---------- Uploads ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=100

# ---------- Retrieval ----------
RETRIEVAL_TOP_K=8
# ---- Grounding gate -------------------------------------------------------
# The tutor returns outside_material instead of guessing unless EITHER signal
# clears its threshold. Thresholds are PER PROVIDER because the local hashing
# vectoriser and Gemini produce different similarity distributions; one shared
# number cannot be correct for both.
#
# Calibrate for the space you are actually running with:
#   MONGODB_URI=... npx tsx scripts/calibrate_grounding.ts
# and copy the printed values here.
#
# NOTE: GROUNDING_SIMILARITY_THRESHOLD_GEMINI is intentionally left EMPTY. Until
# you calibrate it, the Gemini gate FAILS CLOSED (refuses on similarity alone
# and relies on lexical coverage only). That is deliberate — using the local
# number for Gemini would be a fabricated threshold. See README.
GROUNDING_SIMILARITY_THRESHOLD_LOCAL=0.17
GROUNDING_LEXICAL_THRESHOLD_LOCAL=0.55
GROUNDING_SIMILARITY_THRESHOLD_GEMINI=
GROUNDING_LEXICAL_THRESHOLD_GEMINI=

# Legacy single-value override, honoured when the per-provider value is unset.
# Kept so older .env files keep working.
GROUNDING_SIMILARITY_THRESHOLD="")


# ---- Vector space migration ------------------------------------------------
# After switching providers, existing units hold vectors in the OLD space and
# retrieval correctly EXCLUDES them. Run this to migrate them:
#   MONGODB_URI=... npx tsx scripts/reembed.ts
